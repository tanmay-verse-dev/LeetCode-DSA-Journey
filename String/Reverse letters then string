class Solution {
public:
    string reverseByType(string s) {
        int n = s.size();
        int i =0;
        int j = n-1;
        while(i<=j){
            if((isalpha(s[i])) && (isalpha(s[j]))){
                swap(s[i],s[j]);
                i++;
                j--;
            }
            else if((!isalpha(s[i])) && (isalpha(s[j]))){
                i++;
            }
            else if((isalpha(s[i])) && (!isalpha(s[j]))){
                j--;
            }
            else if((!isalpha(s[i])) && (!isalpha(s[j]))){
                i++;
                j--;
            }
            
        }
        int k =0;
        int l = n-1;
        while(k<=l){
            if((!isalpha(s[k])) && (!isalpha(s[l]))){
                swap(s[k],s[l]);
                k++;
                l--;
            }
            else if((isalpha(s[k])) && (!isalpha(s[l]))){
                k++;
            }
            else if((!isalpha(s[k])) && (isalpha(s[l]))){
                l--;
            }
            else if((isalpha(s[k])) && (isalpha(s[l]))){
                k++;
                l--;
            }
            

        }
        return s;

        
    }
};
