class Solution {
public:
    bool consecutiveSetBits(int n) {
        string bin = "";
        int c =0;
        if(n==0)
            return false;
        while(n>0){
            bin = to_string(n%2)+bin;
            n/=2;
        }
        for(int i =0;i<bin.size()-1;i++){
            if(bin[i]=='1' && bin[i+1]=='1')
                //return true;
                c++;
        }
        return c==1;
        
    }
};
