class Solution {
public:
    int matrixSum(vector<vector<int>>& nums) {
        int score = 0;
        int m = nums.size();
        int n = nums[0].size();
        for(int i =0;i<m;i++){
            sort(nums[i].begin(),nums[i].end());
            
        }
        for(int j =0;j<n;j++){
            int maxa = 0;
            for(int k =0;k<m;k++){
                maxa = max(maxa,nums[k][j]);
            }
            score+=maxa;
        }
        return score;
        
    //return 1;
    }
};
