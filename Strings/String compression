class Solution {
public:
    int compress(vector<char>& chars) {
        int i =0;
        int start = 0;
        int n = chars.size();
        while(i<n){
            int j =i;
            while(j<n && chars[i]==chars[j]){
                    j++;
            }
            chars[start++]= chars[i];
            int count = j-i;
            if(count>1){
                string temp = to_string(count);
                for(int k = 0;k<temp.size();k++){
                    chars[start++]= temp[k];
                }
            }
            i=j;
        }
        return start;
        
    }
};
