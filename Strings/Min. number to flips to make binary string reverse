class Solution {
public:
    int minimumFlips(int n) {
        int count = 0;
        string bin ="";
        while(n>0){
            bin += to_string(n%2);
            n/=2;
        }
        int i =0;
        int j =bin.size()-1;
        while(i<j){
            if(bin[i] != bin[j]){
                swap(bin[i],bin[j]);
                count+=2;
            }
            i++;
            j--;
            
        }
        return count;
    }
};
