class Solution {
public:
    bool checkPal(string bin){
        int i =0;
        int j = bin.size()-1;
        while(i<j){
            if(bin[i]!=bin[j]){
                return false;
            }
            i++;
            j--;
            
        }
        return true;

    }
    bool isPalindromic(string s) {
        
        string bin="";
        for(char ch : s){
            string curr="";
            int digi = static_cast<int>(ch);
            //int temp = digi;
            for(int k =0;k<8;k++){
                curr = to_string(digi%2)+curr;
                digi/=2;
            }
            bin+=curr;
            
        }
        return checkPal(bin);
        
    }
};
