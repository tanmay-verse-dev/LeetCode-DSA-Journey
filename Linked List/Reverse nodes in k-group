/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* reverseKGroup(ListNode* head, int k) {
        //Find the length of current Group..
        int count = 0;
        ListNode* temp = head;
        while(count < k){
            if(temp == nullptr){   //Base Case
                return head;
            }
            temp = temp->next;
            count++;
        }
        // Go ahead and reverse the next k- group 
        ListNode* prev = reverseKGroup(temp,k);
        // Now reverse the current group
        temp = head;
        count = 0;
        while(count < k){
            ListNode* nxt = temp->next;
            temp->next = prev;
            prev = temp;
            temp = nxt;
            count++;
        }
        return prev;
    }
};
